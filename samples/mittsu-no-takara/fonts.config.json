{
  "out": "src/fonts",
  "ignore": "｜",
  "story": [
    {
      "file": "script/script.json",
      "paths": [
        "title",
        "end",
        "lines[*].scene",
        "lines[*].text"
      ]
    }
  ],
  "ui": [
    {
      "file": "script/script.json",
      "paths": [
        "cast[*].label",
        "parts[*].name",
        "lines[*].label",
        "notice"
      ]
    },
    {
      "file": "../../packages/reader/src/strings.json",
      "keys": [
        "phase.reading",
        "phase.review",
        "review.heading",
        "review.afterword",
        "button.end",
        "name.and",
        "button.nextLine",
        "status.theirTurn"
      ]
    }
  ]
}
